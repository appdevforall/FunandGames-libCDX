plugins {
    alias(libs.plugins.android.application)
}

configurations {
    natives
}

// libGDX 1.13.x needs androidx.core at runtime. Pin its tree to versions that
// Code On The Go's offline Maven repository carries (the same ones its built-in
// AndroidX templates use); the newer androidx.core libGDX asks for pulls in
// modules (profileinstaller, collection 1.0.0, ...) that the repository lacks.
configurations.configureEach {
    resolutionStrategy {
        force "androidx.core:core:1.9.0"
        force "androidx.collection:collection:1.4.2"
        force "androidx.annotation:annotation:1.8.1"
        force "androidx.lifecycle:lifecycle-runtime:2.5.1"
        force "androidx.lifecycle:lifecycle-common:2.5.1"
    }
}

android {
    namespace = "${{PACKAGE_NAME}}"
    compileSdk = ${{COMPILE_SDK}} 

    defaultConfig {
        applicationId = "${{PACKAGE_NAME}}"
        minSdk = ${{MIN_SDK}}  
        targetSdk = ${{TARGET_SDK}}  
        versionCode = 1
        versionName = "1.0"

        ndk {
            abiFilters "armeabi-v7a", "arm64-v8a"
        }
    }

    sourceSets {
        main {
            jniLibs.srcDirs = ["libs"]
        }
    }

    buildTypes {
        release {
            minifyEnabled false
        }
    }

    compileOptions {
        sourceCompatibility = ${{JAVA_SOURCE_COMPAT}} 
        targetCompatibility = ${{JAVA_TARGET_COMPAT}}  
    }

    packaging {
        jniLibs {
            useLegacyPackaging = true
        }
    }
}

dependencies {
    implementation(libs.gdx.core)
    implementation(libs.gdx.backend.android)
    natives("com.badlogicgames.gdx:gdx-platform:" + libs.versions.gdx.get() + ":natives-armeabi-v7a")
    natives("com.badlogicgames.gdx:gdx-platform:" + libs.versions.gdx.get() + ":natives-arm64-v8a")

${% if LANGUAGE == 'kotlin' %}
tasks.withType<org.jetbrains.kotlin.gradle.tasks.KotlinCompile>().configureEach {
    kotlinOptions.jvmTarget = "${{JAVA_TARGET}}"
}
${% endif %}
}

// libGDX ships its Android .so files inside per-ABI classifier jars; unpack them
// into app/libs/<abi>/ so AGP packages them as jniLibs. Written as a plain Copy
// task (no project access at execution time) so it works with the configuration cache.
tasks.register("copyAndroidNatives", Copy) {
    def natives = configurations.natives
    into layout.projectDirectory.dir("libs")
    ["armeabi-v7a", "arm64-v8a"].each { abi ->
        def jar = natives.filter { it.name.endsWith("natives-" + abi + ".jar") }
        from(zipTree { jar.singleFile }) {
            include "*.so"
            into abi
        }
    }
}

tasks.matching { it.name.contains("merge") && it.name.contains("JniLibFolders") }.configureEach {
    it.dependsOn "copyAndroidNatives"
}
